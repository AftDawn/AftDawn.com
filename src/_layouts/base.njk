<!DOCTYPE html>
<html lang="{{ site.lang }}" class="scroll-smooth">
  <head>
    <meta charset="UTF-8">
    <title>{{ site.title or title }}</title>
    {% favicons site.favicon, appleIconBgColor="#00000000" %}
    {% for tag in metaTags.tags %}
        {% if tag.property %}
            <meta property="{{ tag.property }}" content="{{ tag.content }}">
        {% elif tag.name %}
            <meta name="{{ tag.name }}" content="{{ tag.content }}">
        {% endif %}
    {% endfor %}
    <link rel="canonical" href="{{ site.canonical }}">
    <link rel="stylesheet" href="{{ '/assets/css/styles.css' | url }}">
  </head>
  <body class="antialiased">
    <div class="container mx-auto py-4">
      {% if page.url == "/" %}
        {% include "partials/_header.njk" %}
      {% endif %}
      <main class="text-foreground-light dark:text-foreground-dark px-4">
        {{ content | safe }}
      </main>
      {% if page.url == "/" %}
        {% include "partials/_footer.njk" %}
      {% endif %}
    </div>
    {% if page.url == "/" %}
      {% set menu_toggle %}{% include "menu_toggle.js" %}{% endset %}
      <script>
        // prettier-ignore
        {{ menu_toggle | jsmin | safe }}
      </script>
    {% endif %}

    {% if page.url == "/" %}
      <!-- Slideshow Stuff-->
      <script>
        const slideData = {
          "fursona-slideshow": [
            {% for slide in fursona.slides %}
              {{ slide.text | dump | safe }}{% if not loop.last %},{% endif %}
            {% endfor %}
          ],
          "character-slideshow": [
            {% for slide in characters.slides %}
              {{ slide.text | dump | safe }}{% if not loop.last %},{% endif %}
            {% endfor %}
          ]
        };
      </script>
      {% set slideShow %}{% include "slideshow.js" %}{% endset %}
      <script>
        // prettier-ignore
        {{ slideShow | jsmin | safe }}
      </script>
    {% endif %}

  </body>
</html>