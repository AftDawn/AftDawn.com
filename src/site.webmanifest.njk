---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": "{{ site.title }}",
  "short_name": "{{ author.shortName }}",
  "icons": [
    {
      "src": "{% favicon site.favicon, 192%}",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "{% favicon site.favicon, 512%}",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "theme_color": "{{ site.themeColor }}",
  "background_color": "{{ site.backgroundColor }}",
  "display": "standalone"
}
